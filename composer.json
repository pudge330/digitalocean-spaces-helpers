{
    "name": "bag/digitalocean-spaces-helpers",
    "type": "library",
    "description": "Helper classes to interact with DigitalOcean spaces object storage using the AWS S3 SDK.",
    "keywords": ["DigitalOcean", "Spaces", "AWS", "S3", "Object", "Storage"],
    "license": "MIT",
    "authors": [
        {
            "name": "Brandon Garcia",
            "email": "public@bgarcia.dev",
            "homepage": "https://bgarcia.dev",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "BAG\\Spaces\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAG\\Spaces\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-simplexml": "*",
        "aws/aws-sdk-php": "^3.402",
        "symfony/console": "^7.4",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/var-dumper": "^7.4"
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "php tests/integration.php"
    },
    "config": {
        "sort-packages": true
    }
}
